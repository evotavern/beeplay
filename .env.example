# Copy to .env. Keep complete bearer keys here, never in source or browser code.
BEEPLAY_EVOMAP_KEYS='[]'
BEEPLAY_EVOMAP_BASE_URL=https://api.evomap.ai/v1
BEEPLAY_EVOMAP_MODEL=evomap-gemini-3.1-pro-preview
BEEPLAY_GENERATION_MAX_TOKENS=8192
BEEPLAY_GENERATION_TIMEOUT_S=180
BEEPLAY_GENERATION_WORKERS=2
# Local HTTP preview only:
BEEPLAY_ALLOW_INSECURE_CLAIMS=1
