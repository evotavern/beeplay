# Beeplay — /etc/caddy/Caddyfile
#
# Caddy terminates TLS (certificates are obtained and renewed automatically),
# serves static assets straight from disk, and proxies everything else to the
# uvicorn process listening on localhost.

beeplay.top {
	encode zstd gzip

	# Long-lived assets: the htmx build is version-pinned, icons and brand art
	# are stable.
	@immutable path /assets/vendor/* /assets/icons/* /assets/brand/*
	handle @immutable {
		root * /srv/beeplay
		file_server
		header Cache-Control "public, max-age=604800"
	}

	# app.js changes on every deploy, so it must not be cached for a week.
	handle /assets/* {
		root * /srv/beeplay
		file_server
		header Cache-Control "no-cache"
	}

	# Unpacked games, served straight from state rather than through uvicorn.
	# Content-addressed by hash, so a given path's bytes never change.
	handle_path /games/* {
		root * /var/lib/beeplay/games
		file_server
		header Cache-Control "public, max-age=31536000, immutable"
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	log {
		output file /var/log/caddy/beeplay.log
	}
}

www.beeplay.top {
	redir https://beeplay.top{uri} permanent
}

# ---------------------------------------------------------------------------
# Generated games — a SEPARATE ORIGIN, on purpose.
#
# Model-generated code must never run on beeplay.top: same-origin would give a
# generated game access to the session cookie. Serving it from its own
# hostname puts it behind the browser's origin boundary.
#
# The CSP below mirrors the mini-tool container's rules, so a game that runs
# here also runs on a real device instead of passing locally and breaking on
# a phone.
#
# Uncomment once generation lands AND an A record exists for
# games.beeplay.top — without DNS, Caddy will repeatedly fail ACME challenges
# for this name.
# ---------------------------------------------------------------------------
# games.beeplay.top {
# 	root * /var/lib/beeplay/games
# 	file_server
#
# 	header {
# 		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; frame-ancestors https://beeplay.top"
# 		X-Content-Type-Options "nosniff"
# 		Cross-Origin-Resource-Policy "cross-origin"
# 		Cache-Control "public, max-age=31536000, immutable"
# 	}
#
# 	log {
# 		output file /var/log/caddy/games.log
# 	}
# }
