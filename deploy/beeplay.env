# /etc/beeplay/beeplay.env — read by beeplay.service and by beeplay-ops.
# release.sh installs this once and never overwrites it, so edits made on the
# server (the webhook URL, thresholds) survive every deploy.

BEEPLAY_DB_PATH=/var/lib/beeplay/beeplay.db
BEEPLAY_GAMES_DIR=/var/lib/beeplay/games
BEEPLAY_FAILED_DIR=/var/lib/beeplay/failed
BEEPLAY_EVENTS_LOG=/var/lib/beeplay/logs/events.jsonl

# Links in alerts. Becomes https://… once TLS is in place.
BEEPLAY_PUBLIC_URL=http://47.251.140.176

# The site runs over plain HTTP for now, so claim cookies are issued without
# the Secure flag. Delete this line once TLS is in place; nothing else changes.
BEEPLAY_ALLOW_INSECURE_CLAIMS=1

# Feishu custom-bot webhook for the 🐝蜂玩BeePlay group. Empty: alerts only go
# to the logs. After editing: systemctl restart beeplay
BEEPLAY_ALERT_WEBHOOK=

# Crash detection (defaults shown).
#BEEPLAY_LOAD_TIMEOUT_S=10
#BEEPLAY_ERROR_WINDOW_S=30
#BEEPLAY_CRASH_MIN_FAILURES=3
#BEEPLAY_CRASH_WINDOW_MIN=30
#BEEPLAY_CRASH_RATIO=0.5
