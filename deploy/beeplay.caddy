beeplay.top {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Long caching is for successful responses only. On 2026-09-24 a week-cached
	# 403 kept phones broken long after the files were readable again.
	handle_path /assets/* {
		root * /srv/beeplay/assets
		header Cache-Control "public, max-age=604800" {
			match status 2xx 304
		}
		file_server
	}

	handle_path /games/* {
		root * /var/lib/beeplay/games
		header Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx 304
		}
		# Uploaded and generated games are untrusted: run them in an opaque
		# origin even when opened directly, matching the in-app iframe.
		header Content-Security-Policy "sandbox allow-scripts"
		# That opaque origin sends Origin: null, so without this a game's own
		# fetch/XHR (audio and model loaders) and module scripts are refused.
		# Safe: the files are public, immutable and served without cookies.
		header Access-Control-Allow-Origin "*"
		file_server
	}

	handle_path /avatars/* {
		root * /var/lib/beeplay/avatars
		# Named by a hash of their contents: a new photo is a new URL.
		header Cache-Control "public, max-age=31536000, immutable" {
			match status 2xx 304
		}
		header X-Content-Type-Options "nosniff"
		file_server
	}

	# What is live: the commit beeplay-release stamped into this release.
	# Never cached, since it must answer for right now.
	handle /version {
		root * /srv/beeplay
		rewrite * /version.json
		header Cache-Control "no-store"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:8000
	}
}

www.beeplay.top {
	redir https://beeplay.top{uri} permanent
}

http://47.251.140.176 {
	redir https://beeplay.top{uri} permanent
}

http:// {
	abort
}
